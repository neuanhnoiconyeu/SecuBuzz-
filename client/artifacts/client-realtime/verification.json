  "architecture": {
    "authentication": "Existing HttpOnly DATA cookie with fresh identity-checked auth:{csrfToken}; no identity query or JWT.",
    "send": "Shared SecureMessagingSession v2 encryption and durable pending envelope; ten-second ack; committed REST-row reconciliation; exact bytes on explicit retry.",
    "receive": "Strict v2 scope validation; existing local decrypt; REST wire-ID/sequence reconciliation including history/live overlap.",
    "keys": "Hint only; refetch signed directory; TOFU review; reconnect and every new send revalidate.",
    "rest": "Explicit transport selector; same crypto/pending record; no automatic fallback or re-encryption.",
    "privacy": "No raw cookie/token/key/frame or decrypted-message logs. Server-authenticated plus TOFU, without independent identity proof."
  },
  "limitations": [
    "Production TLS/reverse-proxy deployment is not exercised by localhost acceptance.",
    "Chrome contexts verified; other browsers, load and multi-node server behavior not verified.",
    "Receipt/unread UI observations are session-local; the audited REST history DTO has no receipt projection.",
    "Automatic realtime retries do not re-encrypt or retry invalid crypto; permanent/conflicting pending IDs require explicit reconciliation."
  ],
