# Yahoo! Security Messenger Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Feature Flags
NEXT_PUBLIC_ENABLE_E2EE=true
NEXT_PUBLIC_ENABLE_BUZZ_ALERTS=true
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING=true

# Debug/Development
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=info

# Authentication (Phase 8.6 / Database Team DB-2)
# API mode is the default. The legacy demo mode is disabled in application configuration.
# Explicit false disables authentication; API/network failures never select a demo.
NEXT_PUBLIC_AUTH_MODE=api
NEXT_PUBLIC_AUTH_API_READY=true
NEXT_PUBLIC_AUTH_API_BASE_PATH=/api/auth
# SERVER-ONLY Next.js proxy destination; never expose credentials or put this in NEXT_PUBLIC_*.
# Development defaults to this loopback origin. Production requires HTTPS when proxying here.
# Browser requests remain same-origin; DATA must allow the exact FRONTEND origin.
AUTH_BACKEND_URL=http://127.0.0.1:5000

# Phase 8.8: this same server-only target also proxies the exact DB-3
# /api/users, /api/friends and /api/blocks routes. No separate social token,
# public backend URL, AI flag or realtime flag is needed for Profiles & Friends.

# Realtime (Phase 8.7A): proposed cookie-session contract, disabled by default.
# Enable only after the Realtime and Database teams agree and implement the contract.
# Real message sends remain disabled until authenticated recipient keys are available.
# NEXT_PUBLIC_WS_URL above is legacy and is NOT used by this Socket.IO adapter.
NEXT_PUBLIC_REALTIME_CONTRACT_READY=false
NEXT_PUBLIC_REALTIME_URL=https://realtime.example.invalid
NEXT_PUBLIC_REALTIME_PATH=/socket.io

# Enable only after mounting the authenticated attachment API on the same origin.
# See docs/attachments.md; this flag alone does not enable server authentication.
NEXT_PUBLIC_ATTACHMENT_API_READY=false

# LiveKit infrastructure. Keep disabled until authenticated token/membership adapters are mounted.
# Only the WebSocket URL is public. Never put LiveKit API keys/secrets in any client env file.
NEXT_PUBLIC_LIVEKIT_ENABLED=false
NEXT_PUBLIC_LIVEKIT_URL=

# Optional local calling harness integration (next dev only).
# Copy dev/.env.calling.example to .env.development.local for the complete settings.
# SECUBUZZ_DEV_CALLS_PROXY=true
# DEV_CALLS_BACKEND_URL=http://127.0.0.1:5101
# NEXT_PUBLIC_DEV_CALLS_ENABLED=true

# AI (Phase 9B): remote @Secu through the SecuBuzz backend (/api/ai), disabled by default.
# Used only with NEXT_PUBLIC_AUTH_MODE=api and NEXT_PUBLIC_AUTH_API_READY=true for real (non-demo) sessions,
# and only after the backend runs with AI_REMOTE_ENABLED=true. The browser never calls Gemini.
# Never put a Gemini key or any AI secret in a NEXT_PUBLIC_* variable; those are sent to browsers.
NEXT_PUBLIC_AI_REMOTE_READY=false

# Security
NEXT_PUBLIC_SECURE_CONTEXT_REQUIRED=true
NEXT_PUBLIC_KEY_ROTATION_DAYS=30
