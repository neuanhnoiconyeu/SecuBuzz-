# Yahoo! Security Messenger Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Feature Flags
NEXT_PUBLIC_ENABLE_E2EE=true
NEXT_PUBLIC_ENABLE_BUZZ_ALERTS=true
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING=true

# Debug/Development
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=info

# Authentication (Phase 8.5)
# Development defaults to an in-memory, explicitly labeled demo when unset.
# Demo authentication is disabled in production, even if this flag says demo.
# Proposed API mode also requires AUTH_API_READY=true plus an agreed CSRF bootstrap.
# No authentication backend or credential database is implemented in this client.
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_AUTH_API_READY=false

# Realtime (Phase 8.7A): proposed cookie-session contract, disabled by default.
# Enable only after the Realtime and Database teams agree and implement the contract.
# Real message sends remain disabled until authenticated recipient keys are available.
# NEXT_PUBLIC_WS_URL above is legacy and is NOT used by this Socket.IO adapter.
NEXT_PUBLIC_REALTIME_CONTRACT_READY=false
NEXT_PUBLIC_REALTIME_URL=https://realtime.example.invalid
NEXT_PUBLIC_REALTIME_PATH=/socket.io

# Security
NEXT_PUBLIC_SECURE_CONTEXT_REQUIRED=true
NEXT_PUBLIC_KEY_ROTATION_DAYS=30
