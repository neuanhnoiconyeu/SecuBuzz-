# Allow only the application packages and Docker helpers into either root context.
**
!client/
!client/**
!server/
!server/**
!DATA/
!DATA/**
!shared/
!shared/**
!docker/
!docker/**
!.dockerignore

# Include only the public guide required by validation documentation tests.
!docs/
docs/**
!docs/docker-development.md

# Never send host dependencies, environment files, databases, or private storage.
**/node_modules
**/.npmrc
**/.yarnrc*
**/.env*
**/*.env
**/dev.env
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite.*
**/*.sqlite3
**/*.sqlite3-*
**/*.sqlite3.*
**/private-attachments
**/.uploads
**/uploads
**/backups
**/secrets
**/credentials.json
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx

# Generated output, evidence, caches, and nested checkouts are not build inputs.
**/.git
**/.aws
**/.azure
**/.codex
**/.agents
**/.kiro
**/.next*
**/dist
**/build
**/out
**/artifacts
**/tmp
**/temp
**/coverage
**/.cache
**/.turbo
**/.swc
**/playwright-report
**/test-results
**/*.log
**/*.tsbuildinfo
**/*.part
**/*.bak
**/*.backup

# Local investigation tools are not application or validation image inputs.
docker/ai-diagnostics.cjs
docker/backend-replacement-check.cjs
docker/focused-browser.cjs
docker/retry-client.cjs

# Committed, non-secret examples are inputs to existing boundary regressions.
!client/.env.example
!server/.env.example
!DATA/.env.example
!DATA/.env.example.txt
