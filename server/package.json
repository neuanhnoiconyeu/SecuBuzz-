{
  "name": "secubuzz-realtime-server",
  "version": "0.1.0",
  "private": true,
  "description": "SecuBuzz Phase 8.7B Socket.IO realtime server infrastructure. Fails closed until Database/Security adapters are integrated.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai/index.ts",
    "./calls": "./src/calls/index.ts",
    "./livekit": "./src/livekit/index.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:api": "node --env-file-if-exists=.env api-main.cjs",
    "ai:check-config": "node --env-file-if-exists=.env src/ai/checkConfig.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test:attachments": "node --test --test-concurrency=1 --test-timeout=60000 test/integration/attachments.test.ts test/db5_db6.test.cjs",
    "test:db5db6": "node --test --test-concurrency=1 --test-timeout=60000 test/db5_db6.test.cjs",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"test/**/*.test.ts\" \"test/**/*.test.cjs\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.19.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
