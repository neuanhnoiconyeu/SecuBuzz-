# Copy to server/dev/calling/.env. Development only; never deploy this harness.
NODE_ENV=development
SECUBUZZ_DEV_CALLS_ENABLED=true
DEV_CALLS_PORT=5101
DEV_CALLS_APP_ORIGIN=http://localhost:3000
# Required: distinct private development passwords, at least 12 characters each.
DEV_CALLS_ALICE_PASSWORD=
DEV_CALLS_BOB_PASSWORD=
# Missing media configuration leaves auth/signaling available and media tokens disabled.
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
