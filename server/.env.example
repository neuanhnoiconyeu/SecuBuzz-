# SecuBuzz realtime server (Phase 8.7B) — standalone process settings.
# Copy to server/.env for local runs (.env is gitignored). These are configuration, not secrets.
#
# The standalone server ships without a session resolver or authorizer, so it starts in
# fail-closed mode and rejects every connection with REALTIME_UNAVAILABLE. Real sessions,
# conversation membership and message persistence come from Database Team adapters
# (see docs/realtime-server-integration.md).

# Bind address and port. Keep loopback for development; terminate TLS in front of it in production.
REALTIME_HOST=127.0.0.1
REALTIME_PORT=5100

# Must match the client's NEXT_PUBLIC_REALTIME_PATH (default /socket.io).
REALTIME_PATH=/socket.io

# Socket.IO namespace. The client selects it with the path of NEXT_PUBLIC_REALTIME_URL,
# so keep "/" unless that URL has a matching path.
REALTIME_NAMESPACE=/

# Exact browser origins allowed to connect, comma-separated. No wildcards.
# Plain HTTP is accepted only for localhost, 127.0.0.1 and [::1].
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Name of the HttpOnly session cookie issued by the Database Team's auth service.
REALTIME_SESSION_COOKIE=secubuzz_session
