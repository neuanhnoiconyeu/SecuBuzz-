# SecuBuzz realtime server (Phase 8.7B) — standalone process settings.
# Copy to server/.env for local runs (.env is gitignored). These are configuration, not secrets.
#
# The standalone server ships without a session resolver or authorizer, so it starts in
# fail-closed mode and rejects every connection with REALTIME_UNAVAILABLE. Real sessions,
# conversation membership and message persistence come from Database Team adapters
# (see docs/realtime-server-integration.md).

# Bind address and port. Keep loopback for development; terminate TLS in front of it in production.
REALTIME_HOST=127.0.0.1
REALTIME_PORT=5100

# Must match the client's NEXT_PUBLIC_REALTIME_PATH (default /socket.io).
REALTIME_PATH=/socket.io

# Socket.IO namespace. The client selects it with the path of NEXT_PUBLIC_REALTIME_URL,
# so keep "/" unless that URL has a matching path.
REALTIME_NAMESPACE=/

# Exact browser origins allowed to connect, comma-separated. No wildcards.
# Plain HTTP is accepted only for localhost, 127.0.0.1 and [::1].
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Name of the HttpOnly session cookie issued by the Database Team's auth service.
REALTIME_SESSION_COOKIE=secubuzz_session

# LiveKit: token signing is server-side only. See docs/livekit.md.
# Standalone startup has no authentication adapters and always refuses token issuance.
LIVEKIT_ENABLED=false
# wss://your-livekit-host (ws://127.0.0.1:7880 is permitted only outside production).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Map frontend catalog IDs to real authorized group conversation IDs. Empty keeps voice unavailable.
# Example shape: {"lounge":"<real-group-conversation-id>"}
LIVEKIT_ROOM_CONVERSATIONS={}

# Phase 9B — Gemini AI (server/src/ai, docs/phase9b-gemini-integration.md)
# The AI API is a handler mounted by the Database Team's API server; this realtime process does not
# serve it. `npm run ai:check-config` prints a sanitized report of these settings and never contacts Google.
# GEMINI_API_KEY is a secret. Leave it empty here and set it only in server/.env (gitignored).
# Never put it in client env files, NEXT_PUBLIC_* variables, logs or commits.
# Zero cost: use a key whose Google Cloud project has no active billing account (free tier only).
# Free-tier models, quotas and terms can change; check them before enabling remote AI.
# Google may use free-tier prompts and responses to improve its products, and human reviewers may
# read them, so SecuBuzz refuses Messenger content and credential-like text and asks for consent.
GEMINI_API_KEY=
# The only allowed model. There is no fallback model.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
# Master switch. Only the exact value "true" enables remote AI. Keep false.
AI_REMOTE_ENABLED=false
# Google project quota for this model, copied from the AI Studio rate-limit page. Required to
# enable; there are no defaults. Limits apply per project, and requests per day reset at midnight Pacific.
AI_PROJECT_RPM=
AI_PROJECT_RPD=
# SecuBuzz policy limits, not Google quotas. Defaults shown.
# AI_USER_RPM=3
# AI_USER_RPD=25
# AI_MAX_CONCURRENT=2
# AI_MAX_INPUT_CHARS=8000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_TIMEOUT_MS=12000
# One identifier per Google Cloud project; every process and key of that project must share it.
# AI_QUOTA_SCOPE=default
# Exact browser origins allowed to call /api/ai, comma-separated. Empty refuses every request.
AI_ALLOWED_ORIGINS=http://localhost:3000
# AI_SESSION_COOKIE=secubuzz_session
# HMAC secret (32+ characters) for consent tokens, shared by every API process. Required in production
# when remote AI is enabled; otherwise a random per-process secret is used. Set it only in server/.env.
AI_CONSENT_SECRET=
# Local development only: in-memory quota store (single process, forgotten on restart). Refused in production.
AI_LOCAL_DEV_MEMORY_QUOTA=false
