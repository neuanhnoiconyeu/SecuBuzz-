{
  "mode": "fallback",
  "css": "\n:root { --motion-standard: 200ms; --ease-out: cubic-bezier(.2,.7,.2,1); }\nbody { font: 16px system-ui; background: #f4f1f7; margin: 40px; }\ndetails { width: 360px; border: 1px solid #c9b0dc; background: white; }\nsummary { padding: 12px; cursor: pointer; }\n.panel { background: #f1eafa; padding: 16px; }\n.panel p { margin: 0 0 12px; }\n/* CSS-only native disclosure entry/exit. No animated height or React lifecycle. */\n@media (prefers-reduced-motion: no-preference) {\n  /* Retaining native contents for a visual exit also retains accessibility in\n     Chromium unless closed descendants become inert. Gate all three features. */\n  @supports selector(details::details-content) and (transition-behavior: allow-discrete) and (interactivity: unsupported-test-value) {\n    .conversation-security-details::details-content,\n    .debug-console::details-content {\n      opacity: 0;\n      transform: translateY(-4px);\n      transition:\n        opacity var(--motion-standard, 200ms) var(--ease-out),\n        transform var(--motion-standard, 200ms) var(--ease-out),\n        content-visibility var(--motion-standard, 200ms) allow-discrete;\n    }\n\n    .conversation-security-details[open]::details-content,\n    .debug-console[open]::details-content {\n      opacity: 1;\n      transform: translateY(0);\n    }\n\n    .conversation-security-details:not([open]) > .conversation-security-panel,\n    .debug-console:not([open]) > .debug-log {\n      interactivity: inert;\n      pointer-events: none;\n    }\n\n    /* Replace the previous entrance-only keyframes; avoid two simultaneous fades. */\n    .conversation-security-details[open] .conversation-security-panel,\n    .debug-console[open] .debug-log {\n      animation: none;\n    }\n  }\n}\n",
