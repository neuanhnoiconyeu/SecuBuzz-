PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Relative paths resolve from DATA/, independent of the process working directory.
DB_PATH=server/database/database.sqlite
DB_BUSY_TIMEOUT_MS=5000
# Explicit local-development opt-in. Forbidden when NODE_ENV=production.
AUTH_ALLOW_HTTP_LOCAL=true
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000
AUTH_SESSION_TTL_SECONDS=28800
# Production only: exact trusted TLS-proxy peer IPs, comma-separated. No CIDRs or wildcards.
AUTH_TRUST_PROXY_IPS=
# Group management stays disabled by default. GROUP_MAX_MEMBERS is required if enabled.
GROUPS_API_ENABLED=false
GROUP_MESSAGING_ENABLED=false
GROUP_MAX_MEMBERS=50
# Approved policy values are 20 per group and 10 per invitee. These are not defaults; leave unset here until separate operational activation.
# GROUP_MAX_PENDING_INVITATIONS_PER_GROUP=
# GROUP_MAX_PENDING_INVITATIONS_PER_INVITEE=
GROUPS_API_GATE_RECORD=
GROUP_MESSAGING_GATE_RECORD=

# Attachments stay disabled. If explicitly enabled, all nine required policy
# settings below must be supplied; these are not automatic deployment defaults.
ATTACHMENTS_API_ENABLED=false
# ATTACHMENT_STORAGE_DIR=
# ATTACHMENT_PENDING_TTL_SECONDS=
# ATTACHMENT_PURGE_DELAY_SECONDS=
# ATTACHMENT_RETENTION_INTERVAL_SECONDS=
# ATTACHMENT_QUOTA_USER_BYTES=
# ATTACHMENT_QUOTA_CONVERSATION_BYTES=
# ATTACHMENT_MAX_PENDING_PER_USER=
# ATTACHMENT_UPLOADS_PER_HOUR=
# ATTACHMENT_MAX_CONCURRENT_UPLOADS_PER_USER=
# ATTACHMENT_MAX_CONCURRENT_UPLOADS_PER_SOURCE=
# Optional process-wide timeout while enabled; no default is supplied.
# ATTACHMENT_UPLOAD_TIMEOUT_SECONDS=
ATTACHMENTS_API_GATE_RECORD=
# In the Docker_Environment, compose.yaml already sets
# ATTACHMENT_STORAGE_DIR=/var/lib/secubuzz/attachments and sets no attachment
# switch or policy setting. Its per-source upload limit is one shared bucket
# for all project users because requests share loopback.
