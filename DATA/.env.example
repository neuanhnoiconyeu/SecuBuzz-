PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Relative paths resolve from DATA/, independent of the process working directory.
DB_PATH=server/database/database.sqlite
DB_BUSY_TIMEOUT_MS=5000
# Explicit local-development opt-in. Forbidden when NODE_ENV=production.
AUTH_ALLOW_HTTP_LOCAL=true
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000
AUTH_SESSION_TTL_SECONDS=28800
# Production only: exact trusted TLS-proxy peer IPs, comma-separated. No CIDRs or wildcards.
AUTH_TRUST_PROXY_IPS=
# Group management stays disabled by default. GROUP_MAX_MEMBERS is required if enabled.
GROUPS_API_ENABLED=false
GROUP_MESSAGING_ENABLED=false
GROUP_MAX_MEMBERS=50
# Approved policy values are 20 per group and 10 per invitee. These are not defaults; leave unset here until separate operational activation.
# GROUP_MAX_PENDING_INVITATIONS_PER_GROUP=
# GROUP_MAX_PENDING_INVITATIONS_PER_INVITEE=
GROUPS_API_GATE_RECORD=
GROUP_MESSAGING_GATE_RECORD=
