      "post": {
        "operationId": "persistEncryptedMessage",
        "summary": "Persist one encrypted envelope through the shared write service",
        "description": "Strict envelope parsing by version. The real verifier checks the authenticated actor and actual recipient against persisted active devices, signatures, exact coverage and the current epoch. The same key state is rechecked on the write connection under BEGIN IMMEDIATE before duplicate lookup or insert. V1/stale/revoked/mismatched state is 403 RECIPIENT_KEYS_UNVERIFIED. Identical currently valid retries return original metadata; changed-content reuse is 409. Reconcile history after uncertain delivery before re-encrypting: an already-stored ID cannot be reused with changed ciphertext/keyId.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          },
          {
            "localSessionCookie": [],
            "csrf": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Authorized DB-4A conversation ID. Version-1 message envelopes additionally require it to fit Kiro's 256-character wire bound."
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Browser-managed origin, exactly allowlisted."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Envelope"
              }
            }
          }
        },
        "responses": {
