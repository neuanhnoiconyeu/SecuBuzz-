{
  "openapi": "3.1.0",
  "info": {
    "title": "SecuBuzz DB-4B encrypted message storage",
    "version": "2.0.0",
    "description": "DATA ciphertext persistence with the real Kiro verifier and persistent device/epoch directory. Default composition accepts only verified v2 sends; v1 is never verified. Missing protocol or directory infrastructure fails closed with 503. See e2ee-keys-openapi.json for the six key APIs. Test-only compositions are isolated and refused in production."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
