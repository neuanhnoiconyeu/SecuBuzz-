        "operationId": "encryptedMessageHistory",
        "summary": "Authorized snapshot-paginated ciphertext history",
        "description": "Both active direct members may read after unfriend; either-direction blocking, archive, disabled accounts and left memberships deny access. Legacy messages remain hidden. Newest sequence first. Snapshot excludes later insertions; tombstones retain their original positions.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Authorized DB-4A conversation ID. Version-1 message envelopes additionally require it to fit Kiro's 256-character wire bound."
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded encrypted messages and tombstones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "400": {
            "description": "Fixed safe code and allowlisted fields; never includes payloads, keys or diagnostics.",
