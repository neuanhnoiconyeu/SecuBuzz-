  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-secubuzz_session"
      },
      "localSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "secubuzz_session",
        "description": "Explicit loopback development/test only."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "DB-2 session-bound proof from fresh /api/auth/csrf bootstrap."
      }
    },
    "schemas": {
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "fields"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHENTICATED",
              "SESSION_EXPIRED",
              "FORBIDDEN",
              "CSRF_INVALID",
              "NOT_FOUND",
              "CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "RECIPIENT_KEYS_UNAVAILABLE",
              "RECIPIENT_KEYS_UNVERIFIED",
              "FEATURE_UNAVAILABLE",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "RATE_LIMITED"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Encryption": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/EncryptionV1"
          },
          {
            "$ref": "#/components/schemas/EncryptionV2"
          }
        ],
        "description": "History preserves authorized historical v1. Genuine verified new sending requires v2 and its current keyId."
      },
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "conversationId",
          "senderId",
          "senderName",
          "timestamp",
          "type",
          "encryption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
          },
          "senderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
          },
          "senderName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "const": "text"
          },
          "encryption": {
            "$ref": "#/components/schemas/Encryption"
          }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "storageId",
          "id",
          "conversationId",
          "senderId",
          "senderName",
          "timestamp",
          "type",
          "encryption",
          "storedAt",
          "updatedAt",
          "sequence",
          "revision",
          "state",
          "deletedAt"
        ],
        "properties": {
          "storageId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
          },
          "senderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
          },
          "senderName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "const": "text"
          },
          "encryption": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Encryption"
              },
              {
                "type": "null"
              }
            ]
          },
          "storedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "deleted"
            ]
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "description": "Active records carry the unchanged wire envelope plus authoritative metadata. Tombstones have encryption=null, state=deleted and revision=1. Original encrypted bytes remain in the existing database."
      },
      "StoreResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "message"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "duplicate"
            ]
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          }
        }
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          }
        }
      },
      "ReceiptResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "receipt"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "duplicate"
            ]
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversationId",
              "storageId",
              "messageId",
              "userId",
              "status",
              "observedAt",
              "recordedAt"
            ],
            "properties": {
              "conversationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
              },
              "storageId": {
                "type": "string",
                "format": "uuid"
              },
              "messageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
              },
              "userId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Original client idempotency ID / encrypted AAD field; no whitespace, controls or unpaired surrogates."
              },
              "status": {
                "const": "read"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "EncryptionV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "algorithm",
          "encoding",
          "iv",
          "ciphertext"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "algorithm": {
            "const": "AES-256-GCM"
          },
          "encoding": {
            "const": "base64"
          },
          "iv": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "description": "Canonical padded base64 of exactly 12 bytes."
          },
          "ciphertext": {
            "type": "string",
            "minLength": 24,
            "maxLength": 65536,
            "description": "Canonical padded base64 of more than 16 decoded bytes, including the 128-bit GCM tag. No separate tag/key/plaintext fields."
          }
        }
      },
      "EncryptionV2": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "algorithm",
          "encoding",
          "keyId",
          "iv",
          "ciphertext"
        ],
        "properties": {
          "version": {
            "const": 2
          },
          "algorithm": {
            "const": "AES-256-GCM"
          },
          "encoding": {
            "const": "base64"
          },
          "iv": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "description": "Canonical padded base64 of exactly 12 bytes."
          },
          "ciphertext": {
            "type": "string",
            "minLength": 24,
            "maxLength": 65536,
            "description": "Canonical padded base64 of more than 16 decoded bytes including the attached 128-bit GCM tag."
          },
          "keyId": {
            "type": "string",
            "minLength": 22,
            "maxLength": 22,
            "pattern": "^[A-Za-z0-9_-]{22}$",
            "description": "Canonical unpadded base64url of the current signed epoch ID, authenticated in v2 AAD."
          }
        }
      }
    }
  }
}
