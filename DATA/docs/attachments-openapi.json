      "post": {
        "operationId": "A01",
        "summary": "Upload opaque framed attachment",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.secubuzz.attachment-frame": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful A01 response",
            "x-error-codes": [
              "SUCCESS"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                },
                "example": {
                  "attachment": {
                    "id": "attachment-1",
                    "conversationId": "conversation-1",
                    "messageId": null,
                    "uploadedBy": "user-1",
                    "byteSize": 4,
                    "status": "pending",
                    "createdAt": "2026-01-01T00:00:00.000Z",
                    "expiresAt": "2026-01-02T00:00:00.000Z",
                    "integrityDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "algorithm": "X25519-AESGCM",
                    "formatVersion": "v1",
                    "encryptedMetadata": "opaque-metadata"
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "x-error-codes": [
              "VALIDATION_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "SESSION_EXPIRED or UNAUTHENTICATED",
            "x-error-codes": [
              "SESSION_EXPIRED",
              "UNAUTHENTICATED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
