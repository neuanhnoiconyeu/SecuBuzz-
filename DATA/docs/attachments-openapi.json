{
  "openapi": "3.1.0",
  "info": {
    "title": "SecuBuzz Attachment API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "fields"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "code": "NOT_FOUND",
          "fields": []
        }
      },
      "Attachment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "conversationId",
          "messageId",
          "uploadedBy",
          "byteSize",
          "status",
          "createdAt",
          "expiresAt",
          "integrityDigest",
          "algorithm",
          "formatVersion",
          "encryptedMetadata"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "messageId": {
            "type": "string",
            "nullable": true
          },
          "uploadedBy": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "deleted"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "integrityDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "algorithm": {
            "type": "string"
          },
          "formatVersion": {
            "type": "string"
          },
          "encryptedMetadata": {
            "type": "string"
          }
        },
        "example": {
          "id": "attachment-1",
          "conversationId": "conversation-1",
          "messageId": "message-1",
          "uploadedBy": "user-1",
          "byteSize": 4,
          "status": "ready",
          "createdAt": "2026-01-01T00:00:00.000Z",
          "expiresAt": null,
          "integrityDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "algorithm": "X25519-AESGCM",
          "formatVersion": "v1",
          "encryptedMetadata": "opaque-metadata"
        }
      },
      "UploadResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachment"
        ],
        "properties": {
          "attachment": {
            "$ref": "#/components/schemas/Attachment"
          }
        },
        "example": {
          "attachment": {
            "id": "attachment-1",
            "conversationId": "conversation-1",
            "messageId": null,
            "uploadedBy": "user-1",
            "byteSize": 4,
            "status": "pending",
            "createdAt": "2026-01-01T00:00:00.000Z",
            "expiresAt": "2026-01-02T00:00:00.000Z",
            "integrityDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "algorithm": "X25519-AESGCM",
            "formatVersion": "v1",
            "encryptedMetadata": "opaque-metadata"
          }
        }
      },
      "AttachmentList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachments"
        ],
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          }
        },
        "example": {
          "attachments": [
            {
              "id": "attachment-1",
              "conversationId": "conversation-1",
              "messageId": "message-1",
              "uploadedBy": "user-1",
              "byteSize": 4,
              "status": "ready",
              "createdAt": "2026-01-01T00:00:00.000Z",
              "expiresAt": null,
              "integrityDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "algorithm": "X25519-AESGCM",
              "formatVersion": "v1",
              "encryptedMetadata": "opaque-metadata"
            }
          ]
        }
      },
      "AttachmentSearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "items": [],
          "nextCursor": null
        }
      },
      "AttachmentAssociationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversationId",
          "messageId",
          "attachmentIds"
        ],
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "attachmentIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "example": {
          "conversationId": "conversation-1",
          "messageId": "message-1",
          "attachmentIds": [
            "attachment-1"
          ]
        }
      }
    }
  },
