            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Wrap"
            },
            "description": "Strictly ordered by recipientUserId then recipientDeviceKeyId; exactly all active devices of both participants."
          },
          "signature": {
            "type": "string",
            "minLength": 86,
            "maxLength": 86,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Canonical unpadded base64url; decoded length and public points/signatures are validated by Kiro's protocol."
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "creatorUserId": {
            "type": "string",
            "minLength": 1,
